<?xml version="1.0"?>
<!-- Consistency check of the cancellation right's representation (portfolio.xml): the same right
     written with the USD floating leg telescoped away (Hagan, Callable X-CCY Swap, eqs. 1.4-1.5).
     Under single-curve SOFR discounting the exercised USD flows of the cancel right (receive SOFR +
     20 bp, receive USD 10m at maturity, pay the USD 10m fee on the cancellation date) are worth
     exactly the remaining 20 bp spread stream, so the right equals a Bermudan option into
       receive 20 bp (A360, quarterly) on USD 10m, no notional exchange,
       pay 2.25% (30/360, annual) on EUR 9.7m with the final exchange,
     with the EUR 9.7m rebate on the cancellation date. Both representations must agree within the
     Monte Carlo error. -->
<Portfolio>
  <Trade id="XCCY_CANCEL_RIGHT_REDUCED_USDSOFR_EURFIX_5Y">
    <TradeType>Swaption</TradeType>
