<?xml version="1.0"?>
<!-- ORE's LGM finite-difference callable bond engine on the same bond (24 time steps per year;
     the event-time-grid variant omits the coupon paid on the first event date, see
     ore-fmm/docs/A5_PLAN.md section 10). -->
<PricingEngines>
  <Product type="Bond">
    <Model>DiscountedCashflows</Model>
    <ModelParameters/>
    <Engine>DiscountingRiskyBondEngine</Engine>
    <EngineParameters>
      <Parameter name="TimestepPeriod">6M</Parameter>
    </EngineParameters>
  </Product>
  <Product type="CallableBond">
    <Model>LGM</Model>
    <ModelParameters>
      <Parameter name="Calibration">Bootstrap</Parameter>
      <Parameter name="CalibrationStrategy">CoterminalATM</Parameter>
      <Parameter name="ReferenceCalibrationGrid">1Y,2Y,3Y,4Y</Parameter>
      <Parameter name="Reversion">0.02</Parameter>
      <Parameter name="ReversionType">HullWhite</Parameter>
      <Parameter name="Volatility">0.01</Parameter>
      <Parameter name="VolatilityType">Hagan</Parameter>
      <Parameter name="ShiftHorizon">0.5</Parameter>
      <Parameter name="Tolerance">0.20</Parameter>
    </ModelParameters>
    <Engine>FD</Engine>
    <EngineParameters>
      <Parameter name="Scheme">Douglas</Parameter>
      <Parameter name="StateGridPoints">128</Parameter>
      <Parameter name="TimeStepsPerYear">24</Parameter>
      <Parameter name="MesherEpsilon">1e-4</Parameter>
    </EngineParameters>
  </Product>
  <GlobalParameters>
    <Parameter name="GenerateAdditionalResults">true</Parameter>
    <Parameter name="ContinueOnCalibrationError">false</Parameter>
  </GlobalParameters>
</PricingEngines>
