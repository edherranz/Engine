      </DiscountCurve>
    </DiscountCurves>
    <IndexCurves>
      <IndexCurve index="USD-SOFR">
        <ShiftType>Absolute</ShiftType>
        <Shifts>0.00005,0.00005,0.00005,0.00005,0.00005,0.00005,0.00005,0.00005,0.00005,0.00005,0.00005,0.00005</Shifts>
        <ShiftTenors>3M,6M,9M,1Y,18M,2Y,3Y,4Y,5Y,6Y,7Y,10Y</ShiftTenors>
      </IndexCurve>
    </IndexCurves>
  </StressTest>
